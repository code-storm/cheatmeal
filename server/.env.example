# Copy to .env for local dev. In production (Render), these are set as
# dashboard env vars instead - see render.yaml.

# Local SQLite file, used only when TURSO_DATABASE_URL below is unset.
DATABASE_URL="file:./dev.db"

# Production only (Turso) - leave both unset for local dev, which falls
# back to the local DATABASE_URL file above (see src/lib/prisma.ts).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signing secret for auth JWTs. Generate a real random value for production
# (e.g. `openssl rand -base64 32`) - never reuse the local dev value.
JWT_SECRET="dev-secret-change-me"

# Port the server listens on. Render sets this automatically; only needed
# locally if you want something other than the 4000 default.
PORT=4000

# The frontend's origin, used for the CORS allowlist. Must be the exact
# origin (scheme + host, no trailing slash) the frontend is served from.
CLIENT_ORIGIN="http://localhost:5173"
