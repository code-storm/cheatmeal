datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  profile                 PregnancyProfile?
  dailyPlans              DailyPlan[]
  mealServings            MealServingLog[]
  customTasks             CustomTask[]
  userRewards             UserReward[]
  userBadges              UserBadge[]
  dailyChallengeInstances DailyChallengeInstance[]
  eventProgress           EventProgress[]
}

model PregnancyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  age                  Int
  prePregnancyWeightKg Float
  heightCm             Float?

  weekAtSignup Int
  signupDate   DateTime @default(now())
  lmpDate      DateTime

  currentWeightKg Float?
  updatedAt       DateTime @updatedAt

  dietPreference String @default("NO_RESTRICTION")

  pointsBalance     Int     @default(0)
  totalPointsEarned Int     @default(0)
  activeSkinSlug    String  @default("default")
  activeAvatarSlug  String?

  currentStreak      Int     @default(0)
  longestStreak      Int     @default(0)
  lastStreakDate     String?
  lastLoginBonusDate String?

  // Streak forgiveness: a monthly passive grant that auto-bridges exactly
  // one missed day, so a single bad day doesn't reset currentStreak to 1.
  // Deliberately outside the points economy - not purchasable, not
  // user-spent (see streak.service.ts).
  streakGraceTokens  Int     @default(0)
  lastGraceGrantDate String? // "YYYY-MM"
}

// NOTE: SQLite's Prisma connector does not support native `enum` types in
// schema.prisma (unlike Postgres/MySQL) - the schema fails validation if we
// keep `enum ItemType { ... }` etc. with provider = "sqlite". We preserve the
// exact field names/shape from the spec but store these as String columns,
// and enforce the allowed value sets ("MEAL" | "EXERCISE" | "HABIT" | "GROOMING",
// the 7 MealSlot values, "PENDING" | "COMPLETED" | "SKIPPED") at the TypeScript
// layer via union types exported from src/lib/enums.ts.

model TaskTemplate {
  id           String  @id @default(cuid())
  slug         String  @unique
  type         String
  mealSlot     String?
  defaultTime  String
  name         String
  description  String
  instructions String?

  minWeek Int
  maxWeek Int

  nutrientTags    String
  rotationPoolKey String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  dietType String @default("VEGETARIAN")
  calories Int    @default(0)
  proteinG Float  @default(0)
  carbsG   Float  @default(0)
  fatG     Float  @default(0)

  dailyTasks   DailyTask[]
  mealServings MealServingLog[]
}

model FoodAvoidRule {
  id        String  @id @default(cuid())
  foodName  String
  matchTags String
  reason    String
  minWeek   Int     @default(1)
  maxWeek   Int     @default(42)
  severity  String  @default("avoid")
  source    String?
}

model ActivityAvoidRule {
  id           String  @id @default(cuid())
  activityName String
  matchTags    String
  reason       String
  minWeek      Int     @default(1)
  maxWeek      Int     @default(42)
  severity     String  @default("avoid")
  source       String?
}

model DailyPlan {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id])
  date                      String
  pregnancyWeekAtGeneration Int
  generatedAt               DateTime @default(now())

  tasks               DailyTask[]
  customTaskInstances CustomTaskInstance[]

  @@unique([userId, date])
}

model DailyTask {
  id             String       @id @default(cuid())
  dailyPlanId    String
  dailyPlan      DailyPlan    @relation(fields: [dailyPlanId], references: [id])
  taskTemplateId String
  taskTemplate   TaskTemplate @relation(fields: [taskTemplateId], references: [id])

  scheduledTime String
  status        String    @default("PENDING")
  completedAt   DateTime?

  calories Int   @default(0)
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)

  pointsAwarded Int @default(0)

  @@index([dailyPlanId])
}

model CustomTask {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  type          String // ItemType, reused purely for badge coloring
  scheduledTime String // "HH:mm"
  recurrence    String // "ONE_TIME" | "DAILY"
  startDate     String // "YYYY-MM-DD" - first date this task is eligible to appear
  isActive      Boolean  @default(true) // "delete" = set false; keeps history intact
  createdAt     DateTime @default(now())

  instances CustomTaskInstance[]
}

model CustomTaskInstance {
  id            String     @id @default(cuid())
  customTaskId  String
  customTask    CustomTask @relation(fields: [customTaskId], references: [id])
  dailyPlanId   String
  dailyPlan     DailyPlan  @relation(fields: [dailyPlanId], references: [id])
  scheduledTime String // snapshot of customTask.scheduledTime at sync time
  status        String     @default("PENDING")
  completedAt   DateTime?
  pointsAwarded Int        @default(0) // snapshot, flat CUSTOM_TASK_POINTS

  @@unique([customTaskId, dailyPlanId])
}

model RewardItem {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  category    String // "SKIN" | "AVATAR" | "POWER"
  rarity      String  @default("COMMON") // "COMMON" | "RARE" | "EPIC" | "LEGENDARY"
  costPoints  Int
  icon        String // emoji, for display
  powerKey    String? // only for category=POWER: "TOMORROW_PREVIEW" | "FRESH_PICK"
  isActive    Boolean @default(true)
  imageUrl    String? // real illustrated art, overrides icon/CSS swatch when present

  // Pregnancy-week-scoped scarcity (both nullable; null = always
  // purchasable, true for every item today). Compared against each user's
  // OWN computeCurrentWeek output, not wall-clock time - see
  // rewards.routes.ts. Once unlocked, ownership never expires; only the
  // ability to newly purchase it is gated by this window.
  availableFromWeek  Int?
  availableUntilWeek Int?

  // Crossover-event scoping (nullable - most items belong to no event).
  // A shared, wall-clock-based scarcity axis, independent of the
  // pregnancy-week one above - see events.service.ts. Ownership, once
  // granted, never expires here either; only new-purchase eligibility is
  // gated by the event's lifecycle stage.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  unlocks UserReward[]
}

model UserReward {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  rewardItemId String
  rewardItem   RewardItem @relation(fields: [rewardItemId], references: [id])
  unlockedAt   DateTime   @default(now())

  @@unique([userId, rewardItemId])
}

model Badge {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  icon        String
  criteriaKey String
  isActive    Boolean @default(true)
  imageUrl    String?

  // See RewardItem.eventId - same nullable event-scoping, same semantics.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  unlocks UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id])
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model DailyChallengeTemplate {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  difficulty  String
  proofType   String
  bonusPoints Int
  isActive    Boolean @default(true)

  instances DailyChallengeInstance[]
}

model DailyChallengeInstance {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id])
  templateId String
  template   DailyChallengeTemplate @relation(fields: [templateId], references: [id])
  date       String

  difficulty  String
  title       String
  description String
  proofType   String
  bonusPoints Int

  status       String    @default("PENDING")
  proofCaption String?
  completedAt  DateTime?

  @@unique([userId, date, difficulty])
}

// Crossover/sponsored content drops ("CheatMeal x <sponsor>") - a shared,
// wall-clock-based scarcity axis (startsAt/endsAt), deliberately separate
// from RewardItem's pregnancy-week-relative scarcity (availableFromWeek/
// availableUntilWeek): every user sees the same event window at the same
// real time, which is what makes it feel like a live event rather than a
// personal milestone. isActive is a manual kill-switch only (e.g. a
// content issue found after launch) - it is NOT how lifecycle stage
// (upcoming/active/ending-soon/retired) is determined; that is always
// computed fresh from (now, startsAt, endsAt, isActive) in
// events.service.ts, never persisted, so there is no second source of
// truth that can drift from the real dates.
model Event {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String
  description String
  sponsorName String?
  themeSlug   String // CSS/asset namespace key, e.g. "tokidoki"

  heroImageUrl String?
  cardImageUrl String?

  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())

  rewardItems   RewardItem[]
  badges        Badge[]
  eventProgress EventProgress[]

  @@index([startsAt, endsAt])
}

// Per-user, per-event progression ("battle pass" style tier track) -
// pointsEarnedDuringEvent is a SEPARATE counter from
// PregnancyProfile.totalPointsEarned, credited alongside it only while
// this event is active, so a long-time user's lifetime points don't
// instantly max a brand-new event's tier ladder. claimedTiers is a
// comma-separated list of already-granted tier numbers, so a threshold
// crossing can never grant the same tier's reward twice.
model EventProgress {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  pointsEarnedDuringEvent Int    @default(0)
  tierReached             Int    @default(0)
  claimedTiers            String @default("")

  @@unique([userId, eventId])
}

model MealServingLog {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  taskTemplateId  String
  taskTemplate    TaskTemplate @relation(fields: [taskTemplateId], references: [id])
  rotationPoolKey String
  servedDate      String

  @@index([userId, rotationPoolKey, servedDate])
}
