datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  profile      PregnancyProfile?
  dailyPlans   DailyPlan[]
  mealServings MealServingLog[]
  customTasks  CustomTask[]
  userRewards  UserReward[]
  userBadges              UserBadge[]
  dailyChallengeInstances DailyChallengeInstance[]
}

model PregnancyProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  age                  Int
  prePregnancyWeightKg Float
  heightCm             Float?

  weekAtSignup Int
  signupDate   DateTime @default(now())
  lmpDate      DateTime

  currentWeightKg Float?
  updatedAt       DateTime @updatedAt

  dietPreference String @default("NO_RESTRICTION")

  pointsBalance     Int     @default(0)
  totalPointsEarned Int     @default(0)
  activeSkinSlug    String  @default("default")
  activeAvatarSlug  String?

  currentStreak      Int     @default(0)
  longestStreak       Int     @default(0)
  lastStreakDate      String?
  lastLoginBonusDate  String?

  // Streak forgiveness: a monthly passive grant that auto-bridges exactly
  // one missed day, so a single bad day doesn't reset currentStreak to 1.
  // Deliberately outside the points economy - not purchasable, not
  // user-spent (see streak.service.ts).
  streakGraceTokens  Int     @default(0)
  lastGraceGrantDate String? // "YYYY-MM"
}

// NOTE: SQLite's Prisma connector does not support native `enum` types in
// schema.prisma (unlike Postgres/MySQL) - the schema fails validation if we
// keep `enum ItemType { ... }` etc. with provider = "sqlite". We preserve the
// exact field names/shape from the spec but store these as String columns,
// and enforce the allowed value sets ("MEAL" | "EXERCISE" | "HABIT" | "GROOMING",
// the 7 MealSlot values, "PENDING" | "COMPLETED" | "SKIPPED") at the TypeScript
// layer via union types exported from src/lib/enums.ts.

model TaskTemplate {
  id          String    @id @default(cuid())
  slug        String    @unique
  type        String
  mealSlot    String?
  defaultTime String
  name        String
  description String
  instructions String?

  minWeek Int
  maxWeek Int

  nutrientTags    String
  rotationPoolKey String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  dietType String @default("VEGETARIAN")
  calories Int    @default(0)
  proteinG Float  @default(0)
  carbsG   Float  @default(0)
  fatG     Float  @default(0)

  dailyTasks   DailyTask[]
  mealServings MealServingLog[]
}

model FoodAvoidRule {
  id        String  @id @default(cuid())
  foodName  String
  matchTags String
  reason    String
  minWeek   Int     @default(1)
  maxWeek   Int     @default(42)
  severity  String  @default("avoid")
  source    String?
}

model ActivityAvoidRule {
  id           String  @id @default(cuid())
  activityName String
  matchTags    String
  reason       String
  minWeek      Int     @default(1)
  maxWeek      Int     @default(42)
  severity     String  @default("avoid")
  source       String?
}

model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String
  pregnancyWeekAtGeneration Int
  generatedAt DateTime @default(now())

  tasks               DailyTask[]
  customTaskInstances CustomTaskInstance[]

  @@unique([userId, date])
}

model DailyTask {
  id             String       @id @default(cuid())
  dailyPlanId    String
  dailyPlan      DailyPlan    @relation(fields: [dailyPlanId], references: [id])
  taskTemplateId String
  taskTemplate   TaskTemplate @relation(fields: [taskTemplateId], references: [id])

  scheduledTime String
  status      String     @default("PENDING")
  completedAt DateTime?

  calories Int   @default(0)
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)

  pointsAwarded Int @default(0)

  @@index([dailyPlanId])
}

model CustomTask {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  type          String // ItemType, reused purely for badge coloring
  scheduledTime String // "HH:mm"
  recurrence    String // "ONE_TIME" | "DAILY"
  startDate     String // "YYYY-MM-DD" - first date this task is eligible to appear
  isActive      Boolean  @default(true) // "delete" = set false; keeps history intact
  createdAt     DateTime @default(now())

  instances CustomTaskInstance[]
}

model CustomTaskInstance {
  id            String     @id @default(cuid())
  customTaskId  String
  customTask    CustomTask @relation(fields: [customTaskId], references: [id])
  dailyPlanId   String
  dailyPlan     DailyPlan  @relation(fields: [dailyPlanId], references: [id])
  scheduledTime String // snapshot of customTask.scheduledTime at sync time
  status        String     @default("PENDING")
  completedAt   DateTime?
  pointsAwarded Int        @default(0) // snapshot, flat CUSTOM_TASK_POINTS

  @@unique([customTaskId, dailyPlanId])
}

model RewardItem {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  category    String // "SKIN" | "AVATAR" | "POWER"
  rarity      String  @default("COMMON") // "COMMON" | "RARE" | "EPIC" | "LEGENDARY"
  costPoints  Int
  icon        String // emoji, for display
  powerKey    String? // only for category=POWER: "TOMORROW_PREVIEW" | "FRESH_PICK"
  isActive    Boolean @default(true)

  // Pregnancy-week-scoped scarcity (both nullable; null = always
  // purchasable, true for every item today). Compared against each user's
  // OWN computeCurrentWeek output, not wall-clock time - see
  // rewards.routes.ts. Once unlocked, ownership never expires; only the
  // ability to newly purchase it is gated by this window.
  availableFromWeek  Int?
  availableUntilWeek Int?

  unlocks UserReward[]
}

model UserReward {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  rewardItemId String
  rewardItem   RewardItem @relation(fields: [rewardItemId], references: [id])
  unlockedAt   DateTime   @default(now())

  @@unique([userId, rewardItemId])
}

model Badge {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  icon        String
  criteriaKey String
  isActive    Boolean @default(true)

  unlocks UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id])
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model DailyChallengeTemplate {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  difficulty  String
  proofType   String
  bonusPoints Int
  isActive    Boolean @default(true)

  instances DailyChallengeInstance[]
}

model DailyChallengeInstance {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id])
  templateId   String
  template     DailyChallengeTemplate @relation(fields: [templateId], references: [id])
  date         String

  difficulty   String
  title        String
  description  String
  proofType    String
  bonusPoints  Int

  status       String    @default("PENDING")
  proofCaption String?
  completedAt  DateTime?

  @@unique([userId, date, difficulty])
}

model MealServingLog {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  taskTemplateId  String
  taskTemplate   TaskTemplate @relation(fields: [taskTemplateId], references: [id])
  rotationPoolKey String
  servedDate      String

  @@index([userId, rotationPoolKey, servedDate])
}
